<Project Sdk="Microsoft.NET.Sdk">
  <!--
    swbridge.exe: the Windows half of dsh-solidworks.
    .NET Framework 4.8 ships with Windows 10 1903+ and Windows 11, so the exe needs no runtime install.
    No SOLIDWORKS interop assembly is referenced: every call is late-bound through IDispatch, so one
    build drives 2016 through current releases and the repo builds on Linux CI without SOLIDWORKS.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>12</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>swbridge</AssemblyName>
    <RootNamespace>SwBridge</RootNamespace>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <!-- The SDK appends "+<git commit>" to the informational version by default, which
         changes the exe's bytes on every commit and breaks the reproducible-build check. -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Version>0.1.0</Version>
    <Product>dsh-solidworks bridge</Product>
    <Company>dshworks</Company>
    <Copyright>MIT License</Copyright>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <!-- compat/reflect is a separate dev tool (net8.0); it is not part of the bridge. -->
    <Compile Remove="compat/**" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Drawing" />
    <EmbeddedResource Include="../protocol/tools.json" LogicalName="tools.json" />
  </ItemGroup>
</Project>
